PORT=5002
APP_ORIGIN=http://localhost:5173
ENABLE_DEMO=false
# Verified Google emails only; never a frontend role flag.
ADMIN_EMAILS=
# Use the combined URL OR all three separate values. Keep credentials private.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional development-only file adapter.
DATA_FILE=.data/store.json

# Hosted datastore. Activate mongodb only after the operator copy is verified.
DATABASE_DRIVER=netlify-blobs
MONGODB_URI=
# Optional: defaults to the database named in the URI.
MONGODB_DB=
